# Keep rules for R8 (enabled in the release buildType).
#
# Play Console measures DEX obfuscation; without R8 the app scores ~2%,
# which is below the 25% threshold required to keep full publishing visibility.

# --- Flutter engine / embedding -------------------------------------------
# The embedding is looked up reflectively by the Flutter tool and by plugins.
-keep class io.flutter.app.** { *; }
-keep class io.flutter.plugin.** { *; }
-keep class io.flutter.util.** { *; }
-keep class io.flutter.view.** { *; }
-keep class io.flutter.** { *; }
-keep class io.flutter.plugins.** { *; }

# --- App entry point (referenced from AndroidManifest.xml) -----------------
-keep class com.zaddyai.sajilokhata.MainActivity { *; }

# --- Platform channel payloads ---------------------------------------------
# Keep @Keep-annotated classes and their members (used by plugins that cross
# the platform channel via reflection).
-keep @androidx.annotation.Keep class * { *; }

# --- Optional-dependency noise (classes only present in debug / other SDKs) --
-dontwarn org.slf4j.**
-dontwarn javax.annotation.**
-dontwarn org.chromium.**
-dontwarn kotlin.coroutines.jvm.internal.**

# --- Play Core deferred components ------------------------------------------
# The Flutter engine references these for deferred components / dynamic
# feature modules. This app doesn't ship them, so the classes are absent.
# Generated by AGP into build/app/outputs/mapping/release/missing_rules.txt.
-dontwarn com.google.android.play.core.splitcompat.SplitCompatApplication
-dontwarn com.google.android.play.core.splitinstall.SplitInstallException
-dontwarn com.google.android.play.core.splitinstall.SplitInstallManager
-dontwarn com.google.android.play.core.splitinstall.SplitInstallManagerFactory
-dontwarn com.google.android.play.core.splitinstall.SplitInstallRequest$Builder
-dontwarn com.google.android.play.core.splitinstall.SplitInstallRequest
-dontwarn com.google.android.play.core.splitinstall.SplitInstallSessionState
-dontwarn com.google.android.play.core.splitinstall.SplitInstallStateUpdatedListener
-dontwarn com.google.android.play.core.tasks.OnFailureListener
-dontwarn com.google.android.play.core.tasks.OnSuccessListener
-dontwarn com.google.android.play.core.tasks.Task
